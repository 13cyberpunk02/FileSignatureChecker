<?xml version="1.0" encoding="UTF-8"?><xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified"
  elementFormDefault="qualified" version="3.01" vc:minVersion="1.1"
  xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning">
  <xs:simpleType name="TAccessLevel">
    <xs:annotation>
      <xs:documentation><text>Классификация информации по грифу ограничения доступа.</text></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="общедоступная информация"/>
      <xs:enumeration value="для служебного пользования"/>
      <xs:enumeration value="коммерческая тайна"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="TFileFormat">
    <xs:annotation>
      <xs:documentation><text>Комплексный тип для описания типа и версии передаваемого файла.</text></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Type">
        <xs:annotation>
          <xs:documentation>Тип передаваемого файла: КА - Конъюнктурный анализ.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="КА"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="Version" default="3.01">
        <xs:annotation>
          <xs:documentation>Номер версии схемы.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:decimal">
            <xs:fractionDigits value="2"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="TMeta">
    <xs:annotation>
      <xs:documentation><text>Информация о программном комплексе и версии формата.</text></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Soft">
        <xs:annotation>
          <xs:documentation>Наименование программного продукта (сметной программы).</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Name" type="xs:string">
              <xs:annotation>
                <xs:documentation>Наименование программного комплекса.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="Version" type="xs:string">
              <xs:annotation>
                <xs:documentation>Версия программного комплекса.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="File" type="TFileFormat">
        <xs:annotation>
          <xs:documentation>Тип и версия передаваемого файла.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TLinkFile">
    <xs:annotation>
      <xs:documentation>Описание связи позиции КАЦ с обосновывающими документами.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="FileName" type="xs:string" minOccurs="1">
        <xs:annotation>
          <xs:documentation><text> Ссылки на файлы c обосновывающими документами, подписанные производителями и (или) поставщиками соответствующих материальных ресурсов и оборудования (работ, услуг) и (или) заверенными подписями уполномоченного лица производителей и (или) поставщиков, при использовании обосновывающих документов из открытых источников - подписанные уполномоченным лицом заказчика. Поле должно содержать только имя файла без определения пути к файлу.</text> </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Page" type="xs:positiveInteger">
        <xs:annotation>
          <xs:documentation>Номер страницы обосновывающего документа.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TDate">
    <xs:annotation>
      <xs:documentation>Дата составления коньюнктурного анализа.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Year" type="xs:unsignedShort">
        <xs:annotation>
          <xs:documentation>Год.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Quarter" type="xs:unsignedShort">
        <xs:annotation>
          <xs:documentation>Квартал.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Date" type="xs:date" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Дата коммерческого предложения.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>


  <xs:simpleType name="ExpenseType" final="restriction">
    <xs:annotation>
      <xs:documentation><text>Виды затрат, учтенные в сметной цене материальных ресурсов или оборудования, связанные с их приобретением в соответствии с п.88 Методики, утвержденной приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 4 августа 2020 г. № 421/пр (с изменениями от 7 июля 2022 г. № 557/пр, от 30 января 2024 г. № 55/пр).</text>
<links>Методика определения сметной стоимости строительства, реконструкции, капитального ремонта, сноса объектов капитального строительства, работ по сохранению объектов культурного наследия (памятников истории и культуры) народов Российской Федерации на территории Российской Федерации, утвержденная приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 4 августа 2020 г. № 421/пр (с изменениями от 7 июля 2022 г. № 557/пр, от 30 января 2024 г. № 55/пр); Методика определения сметной стоимости строительства или реконструкции объектов капитального строительства, расположенных за пределами территории Российской Федерации, утвержденная приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 15 июня 2020 г. №317/пр (с изменениями от 25 августа 2022 г. № 698/пр, от 22 декабря 2023 г. № 968/пр).</links></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Тара, упаковка, реквизит (пункт 88 Методики)"/>
      <xs:enumeration value="Стоимость комплекта запасных частей (пункт 88 Методики)"/>
      <xs:enumeration value="Снабженческие наценки (пункт 88 Методики)"/>
      <xs:enumeration value="Расходы на уплату пошлин (пункт 88 Методики)"/>
      <xs:enumeration value="Расходы на уплату налогов (пункт 88 Методики)"/>
      <xs:enumeration value="Расходы на уплату сборов (пункт 88 Методики)"/>
      <xs:enumeration value="Другие таможенные платежи (пункт 88 Методики)"/>
      <xs:enumeration value="Шефмонтаж (подпункт &quot;а&quot; пункта 117 Методики)"/>
      <xs:enumeration value="Шефналадка (подпункт &quot;а&quot; пункта 117 Методики)"/>
      <xs:enumeration value="Доводка (калибровка) (подпункт &quot;б&quot; пункта 117 Методики)"/>
      <xs:enumeration value="Доизготовление (подпункт &quot;в&quot; пункта 117 Методики)"/>
      <xs:enumeration
        value="Изготовление специальной оснастки (подпункт &quot;г&quot; пункта 117 Методики)"/>
      <xs:enumeration
        value="Предварительно установленное программное обеспечение (подпункт &quot;д&quot; пункта 117 Методики)"/>
      <xs:enumeration
        value="Затраты по оценке соответствия оборудования (подпункт &quot;е&quot; пункта 117 Методики)"/>
      <xs:enumeration value="Другие затраты (подпункт &quot;ж&quot; пункта 117 Методики)"/>
      <xs:enumeration value="Комплектация оборудования (пункт 119 Методики)"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:complexType name="TCompany">
    <xs:annotation>
      <xs:documentation><text>Комплексный тип для описания организации производителя/поставщика материальных ресурсов или оборудования, а также организации производителя/поставщика отдельных видов работ или оказания услуг (в том числе услуг по перевозке грузов).</text></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="CompanyName" type="xs:string" minOccurs="1" maxOccurs="1">
        <xs:annotation>
          <xs:documentation><text>Наименование организации производителя/поставщика материальных ресурсов или оборудования, а также организации производителя/поставщика отдельных видов работ или оказания услуг (в том числе услуг по перевозке грузов).</text>
<links>Методика определения сметной стоимости строительства, реконструкции, капитального ремонта, сноса объектов капитального строительства, работ по сохранению объектов культурного наследия (памятников истории и культуры) народов Российской Федерации на территории Российской Федерации, утвержденная приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 4 августа 2020 г. № 421/пр (с изменениями от 7 июля 2022 г. № 557/пр, от 30 января 2024 г. № 55/пр); Методика определения сметной стоимости строительства или реконструкции объектов капитального строительства, расположенных за пределами территории Российской Федерации, утвержденная приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 15 июня 2020 г. №317/пр (с изменениями от 25 августа 2022 г. № 698/пр, от 22 декабря 2023 г. № 968/пр).</links></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="KPP" type="xs:string" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation><text>КПП организации производителя/поставщика, находящейся в Российской Федерации (при проведении КАЦ за границей, при отсутствии кода КПП заполняется аналогом такого кода (при наличии), либо номером, состоящим из 9 цифр вида "000000001" (последняя цифра должна меняться 1,2,3 по порядку, номер для организации должен быть уникальный в рамках КАЦ).</text>
<links>Методика определения сметной стоимости строительства, реконструкции, капитального ремонта, сноса объектов капитального строительства, работ по сохранению объектов культурного наследия (памятников истории и культуры) народов Российской Федерации на территории Российской Федерации, утвержденная приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 4 августа 2020 г. № 421/пр (с изменениями от 7 июля 2022 г. № 557/пр, от 30 января 2024 г. № 55/пр); Методика определения сметной стоимости строительства или реконструкции объектов капитального строительства, расположенных за пределами территории Российской Федерации, утвержденная приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 15 июня 2020 г. №317/пр (с изменениями от 25 августа 2022 г. № 698/пр, от 22 декабря 2023 г. № 968/пр).</links></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="INN" minOccurs="1" maxOccurs="1">
        <xs:annotation>
          <xs:documentation><text>ИНН организации производителя/поставщика, находящейся в Российской Федерации, п.п. 23, 23.1 Методики, утвержденной приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 4 августа 2020 г. № 421/пр (с изменениями от 7 июля 2022 г. № 557/пр, от 30 января 2024 г. № 55/пр) (при проведении КАЦ за границей, при отсутствии кода ИНН заполняется аналогом такого кода (при наличии), либо номером, состоящим из 10 цифр вида "0000000001" (последняя цифра должна меняться 1,2,3 по порядку, номер для организации должен быть уникальный в рамках КАЦ).</text>
<links>Методика определения сметной стоимости строительства, реконструкции, капитального ремонта, сноса объектов капитального строительства, работ по сохранению объектов культурного наследия (памятников истории и культуры) народов Российской Федерации на территории Российской Федерации, утвержденная приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 4 августа 2020 г. № 421/пр (с изменениями от 7 июля 2022 г. № 557/пр, от 30 января 2024 г. № 55/пр); Методика определения сметной стоимости строительства или реконструкции объектов капитального строительства, расположенных за пределами территории Российской Федерации, утвержденная приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 15 июня 2020 г. №317/пр (с изменениями от 25 августа 2022 г. № 698/пр, от 22 декабря 2023 г. № 968/пр).</links></xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{10}|[0-9]{12}|"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="Site" type="xs:string" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation><text>Гиперссылка на веб-сайт производителя/поставщика.
Требуется использовать CDATA для инкапсуляции содержимого.
Пример использования: "...[CDATA[Ваша ссылка]]..."
(При отсутствии у производителя (поставщика) сайта в информационно-телекоммуникационной сети "Интернет" не заполняется.
Приложение № 1 к Методике).</text>
<links>Методика определения сметной стоимости строительства, реконструкции, капитального ремонта, сноса объектов капитального строительства, работ по сохранению объектов культурного наследия (памятников истории и культуры) народов Российской Федерации на территории Российской Федерации, утвержденная приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 4 августа 2020 г. № 421/пр (с изменениями от 7 июля 2022 г. № 557/пр, от 30 января 2024 г. № 55/пр); Методика определения сметной стоимости строительства или реконструкции объектов капитального строительства, расположенных за пределами территории Российской Федерации, утвержденная приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 15 июня 2020 г. №317/пр (с изменениями от 25 августа 2022 г. № 698/пр, от 22 декабря 2023 г. № 968/пр).</links></xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Status" minOccurs="1" maxOccurs="1">
        <xs:annotation>
          <xs:documentation><text>Статус организации (производитель(1) / поставщик (2)) (Приложение № 1 к Методике), утвержденной приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 4 августа 2020 г. № 421/пр (с изменениями от 7 июля 2022 г. № 557/пр, от 30 января 2024 г. № 55/пр).</text>
<links>Методика определения сметной стоимости строительства, реконструкции, капитального ремонта, сноса объектов капитального строительства, работ по сохранению объектов культурного наследия (памятников истории и культуры) народов Российской Федерации на территории Российской Федерации, утвержденная приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 4 августа 2020 г. № 421/пр (с изменениями от 7 июля 2022 г. № 557/пр, от 30 января 2024 г. № 55/пр); Методика определения сметной стоимости строительства или реконструкции объектов капитального строительства, расположенных за пределами территории Российской Федерации, утвержденная приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 15 июня 2020 г. №317/пр (с изменениями от 25 августа 2022 г. № 698/пр, от 22 декабря 2023 г. № 968/пр).</links></xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:unsignedByte">
            <xs:enumeration value="1"/>
            <xs:enumeration value="2"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="StorePlace" type="xs:string" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation><text>Населенный пункт (адрес) расположения склада производителя/поставщика (Приложение № 1 к Методике от 4 августа 2020 г. № 421/пр).</text>
<links>Методика определения сметной стоимости строительства, реконструкции, капитального ремонта, сноса объектов капитального строительства, работ по сохранению объектов культурного наследия (памятников истории и культуры) народов Российской Федерации на территории Российской Федерации, утвержденная приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 4 августа 2020 г. № 421/пр (с изменениями от 7 июля 2022 г. № 557/пр, от 30 января 2024 г. № 55/пр); Методика определения сметной стоимости строительства или реконструкции объектов капитального строительства, расположенных за пределами территории Российской Федерации, утвержденная приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 15 июня 2020 г. №317/пр (с изменениями от 25 августа 2022 г. № 698/пр, от 22 декабря 2023 г. № 968/пр).</links></xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element minOccurs="0" name="CompanyNote" type="xs:string">
        <xs:annotation>
          <xs:documentation>Примечание.</xs:documentation>
        </xs:annotation>
      </xs:element>


    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TSignatures">
    <xs:annotation>
      <xs:documentation><text>Комплексный тип для передачи данных об уполномоченных лицах застройщика или технического заказчика, производителя и (или) поставщика соответствующих материальных ресурсов и оборудования, работ, услуг (в том числе услуг по перевозке грузов) в соответствии с положениями п.п.13-14 Методики, утвержденной приказом Министерства строительства и жилищно-коммунального хозяйства Российской Федерации от 4 августа 2020 г. № 421/пр (с изменениями от 7 июля 2022 г. № 557/пр, от 30 января 2024 г. № 55/пр).</text>
