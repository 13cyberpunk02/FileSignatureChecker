<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ApplicationIcon>icons8-puzzle-matching-50.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icons8-puzzle-matching-50.ico" />
  </ItemGroup>

  <!-- Тестовый проект лежит внутри папки приложения: не компилируем его в приложение -->
  <ItemGroup>
    <Compile Remove="FileSignatureChecker.Tests\**" />
    <Page Remove="FileSignatureChecker.Tests\**" />
    <None Remove="FileSignatureChecker.Tests\**" />
    <EmbeddedResource Remove="FileSignatureChecker.Tests\**" />
  </ItemGroup>

  <!-- Результаты локальной сборки установщика (installer\FileSignatureChecker.iss) -->
  <ItemGroup>
    <None Remove="publish\**;installer-output\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
    <PackageReference Include="MaterialDesignColors" Version="5.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\*.xsd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
