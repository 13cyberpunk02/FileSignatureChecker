<Window x:Class="FileSignatureChecker.SchemaValidationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:FileSignatureChecker.ViewModels"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Проверка схемы XML/GGE"
        Height="600"
        Width="900"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.DataContext>
        <viewModels:SchemaValidationViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Заголовок  -->
        <materialDesign:ColorZone
            Grid.Row="0"
            Padding="16"
            materialDesign:ElevationAssist.Elevation="Dp4"
            Mode="PrimaryMid">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        Kind="FileDocument" />
                    <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="22"
                        FontWeight="Medium"
                        Text="Валидация XML/GGE файлов" />
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!--  Основной контент  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!--  Кнопка загрузки файла  -->
                <Button
                    Command="{Binding LoadFileCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="24"
                            Height="24"
                            Kind="Upload" />
                        <TextBlock Margin="8,0,0,0" Text="Загрузить файл (XML/GGE)" />
                    </StackPanel>
                </Button>

                <!--  Индикатор загрузки  -->
                <ProgressBar
                    Margin="0,10,0,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--  Имя файла  -->
                <TextBlock
                    Margin="0,15,0,0"
                    FontSize="12"
                    Foreground="Gray"
                    Text="{Binding FileName}"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsFileNameVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--  УСПЕШНАЯ ВАЛИДАЦИЯ  -->
                <!--  ПРЕДУПРЕЖДЕНИЕ О ВЕРСИИ СХЕМЫ  -->
                <materialDesign:Card
                    Margin="0,20,0,0"
                    Padding="16"
                    Background="#FFF3E0"
                    Visibility="{Binding SchemaWarning, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="24"
                            Height="24"
                            Margin="0,0,12,0"
                            VerticalAlignment="Top"
                            Foreground="#FF9800"
                            Kind="AlertOutline" />
                        <TextBlock
                            MaxWidth="900"
                            FontSize="13"
                            Foreground="#E65100"
                            Text="{Binding SchemaWarning}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card
                    Margin="0,20,0,0"
                    Padding="20"
                    Visibility="{Binding IsValidationSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <!--  Иконка успеха  -->
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="48"
                                Height="48"
                                Foreground="#4CAF50"
                                Kind="CheckCircle" />
                        </StackPanel>

                        <!--  Текст успеха  -->
                        <TextBlock
                            Margin="0,15,0,0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#4CAF50"
                            Text="{Binding ValidationResultText}" />

                        <!--  Информация о схеме  -->
                        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                            <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="#4CAF50"
                                    Kind="FileDocument" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="#4CAF50"
                                    TextWrapping="Wrap">
                                    <Run Text="Используемая схема: " />
                                    <Run FontWeight="SemiBold" Text="{Binding SchemaFileName, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="#4CAF50"
                                    Kind="FileCode" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="#4CAF50"
                                    TextWrapping="Wrap">
                                    <Run Text="Версия схемы: " />
                                    <Run FontWeight="SemiBold" Text="{Binding SchemaVersion, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!--  ОШИБКИ ВАЛИДАЦИИ  -->
                <StackPanel
                    Visibility="{Binding IsValidationSuccess, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                    <!--  Заголовок ошибок  -->
                    <materialDesign:Card
                        Margin="0,20,0,0"
                        Padding="20"
                        Background="#FFEBEE">
                        <StackPanel>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="48"
                                    Height="48"
                                    Foreground="#F44336"
                                    Kind="AlertCircle" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#F44336"
                                Text="{Binding ValidationResultText}" />

                            <!--  Информация о схеме при ошибке  -->
                            <StackPanel Margin="0,15,0,0" HorizontalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="#666"
                                    TextWrapping="Wrap">
                                    <Run Text="Схема: " />
                                    <Run FontWeight="SemiBold" Text="{Binding SchemaFileName}" />
                                    <Run Text=" (версия " />
                                    <Run Text="{Binding SchemaVersion}" />
                                    <Run Text=")" />
                                </TextBlock>

                                <TextBlock
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#F44336"
                                    Text="{Binding ErrorCount, StringFormat='Найдено ошибок: {0}'}" />
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!--  Панель поиска и экспорта  -->
                    <Grid Margin="0,20,0,10"
                          Visibility="{Binding HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Поиск  -->
                        <TextBox
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.Hint="🔍 Поиск по ошибкам..."
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Кнопка экспорта  -->
                        <Button
                            Grid.Column="1"
                            Command="{Binding ExportToExcelCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Kind="FileExcel" />
                                <TextBlock Margin="8,0,0,0" Text="Экспорт в Excel" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--  Счетчик найденных ошибок  -->
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="12"
                        Foreground="Gray"
                        Visibility="{Binding HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Run Text="Показано: " />
                        <Run FontWeight="Bold" Text="{Binding FilteredErrors.Count, Mode=OneWay}" />
                        <Run Text=" из " />
                        <Run FontWeight="Bold" Text="{Binding Errors.Count, Mode=OneWay}" />
                    </TextBlock>

                    <!--  Список ошибок (карточки)  -->
                    <ItemsControl ItemsSource="{Binding FilteredErrors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card
                                    Margin="0,0,0,15"
                                    Padding="20"
                                    materialDesign:ElevationAssist.Elevation="Dp2">
                                    <StackPanel>
                                        <!--  Номер ошибки  -->
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#F44336">
                                            <Run Text="❌ Ошибка #" />
                                            <Run Text="{Binding ErrorNumber}" />
                                        </TextBlock>

                                        <!--  Расположение  -->
                                        <StackPanel Margin="0,0,0,10"
                                                    Visibility="{Binding Location, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#666"
                                                Text="📍 Расположение:" />
                                            <TextBlock
                                                Margin="20,5,0,0"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Text="{Binding Location}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!--  Путь  -->
                                        <StackPanel Margin="0,0,0,10"
                                                    Visibility="{Binding Path, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#666"
                                                Text="📂 Путь к элементу:" />
                                            <TextBlock
                                                Margin="20,5,0,0"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Foreground="#2196F3"
                                                Text="{Binding Path}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!--  Описание  -->
                                        <StackPanel Margin="0,0,0,10"
                                                    Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#666"
                                                Text="❌ Описание проблемы:" />
                                            <TextBlock
                                                Margin="20,5,0,0"
                                                FontSize="13"
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!--  Требования  -->
                                        <StackPanel Margin="0,0,0,10"
                                                    Visibility="{Binding Details, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#666"
                                                Text="⚙️ Требования к заполнению:" />
                                            <TextBlock
                                                Margin="20,5,0,0"
                                                FontSize="12"
                                                Foreground="#FF9800"
                                                Text="{Binding Details}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!--  Текущее значение  -->
                                        <StackPanel
                                            Visibility="{Binding CurrentValue, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#666"
                                                Text="💡 Текущее значение:" />
                                            <Border
                                                Margin="20,5,0,0"
                                                Padding="10"
                                                Background="#FFF3E0"
                                                BorderBrush="#FF9800"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="#E65100"
                                                    Text="{Binding CurrentValue}"
                                                    TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>