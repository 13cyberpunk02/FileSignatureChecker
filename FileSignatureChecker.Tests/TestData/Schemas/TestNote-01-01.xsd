<?xml version="1.0" encoding="utf-8"?>
<!--
  Маленькая тестовая схема для проверки логики XmlValidationService.
  Специально содержит:
   - два элемента Name с разным смыслом (Organization/Name и Person/Name через тип tPerson);
   - элементы с "опасными" для перевода именами (TotalValue, DocDate);
   - атрибут SchemaVersion с фиксированным значением.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="TestNote">
    <xs:annotation>
      <xs:documentation xml:lang="ru">Тестовая записка</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Organization">
          <xs:annotation>
            <xs:documentation xml:lang="ru">Организация</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Name">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Наименование организации</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="1" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="INN">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">ИНН организации</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:pattern value="[0-9]{10}|[0-9]{12}" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Person" type="tPerson">
          <xs:annotation>
            <xs:documentation xml:lang="ru">Ответственное лицо</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="TotalValue" type="xs:decimal">
          <xs:annotation>
            <xs:documentation xml:lang="ru">Итоговая стоимость</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="DocDate" type="xs:date">
          <xs:annotation>
            <xs:documentation xml:lang="ru">Дата документа</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="SchemaVersion" type="xs:string" use="required" fixed="01.01" />
    </xs:complexType>
  </xs:element>

  <xs:complexType name="tPerson">
    <xs:sequence>
      <xs:element name="Name">
        <xs:annotation>
          <xs:documentation xml:lang="ru">ФИО ответственного лица</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[А-ЯЁа-яё ]+" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
